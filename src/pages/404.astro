---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Elevate With Andy" description="The page you are looking for does not exist or has been moved.">
  <main class="max-w-3xl mx-auto px-6 py-24 flex flex-col items-center justify-center text-center min-h-[60vh]">
    <h1 class="text-2xl font-bold tracking-tight text-[#1e1b21] mb-3">
      Resilience in Motion, But Lost the Path
    </h1>
    
    <p class="text-sm text-neutral-600 max-w-md mb-10 leading-relaxed">
      The link you followed might be broken, or the page may have been removed. Let's get you back on track to your training or gear content.
    </p>

    <!-- Clear Call-to-Action Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 items-center justify-center text-[10px] tracking-widest uppercase font-semibold w-full">
      
      <!-- Button 1: Return Home -->
      <a href="/" class="bg-[#7a7480] text-white px-6 py-3 border border-[#69636e] rounded hover:bg-[#69636e] transition-colors shadow-sm w-full sm:w-auto text-center whitespace-nowrap">
        Return Home
      </a>
      
      <!-- Button 2: YouTube Channel -->
      <a href="https://www.youtube.com/@ElevatewithAndy" target="_blank" rel="noopener noreferrer" class="bg-[#7a7480] text-white px-6 py-3 border border-[#69636e] rounded hover:bg-[#69636e] transition-colors shadow-sm w-full sm:w-auto text-center whitespace-nowrap">
        YouTube Channel
      </a>
    </div>

  </main>
</BaseLayout>
